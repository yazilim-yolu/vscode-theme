  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#5F6690", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#4FC7D9" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp punctuation", "constant.other.placeholder"],
      "settings": { "foreground": "#E3A567" }
    },
    {
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#63C9A8" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": { "foreground": "#E3A567" }
    },
    {
      "scope": [
        "keyword",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": { "foreground": "#A98BF5" }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": { "foreground": "#BFA3FA" }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#9DA6D0" }
    },
    {
      "scope": [
        "punctuation.definition.block",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "meta.brace"
      ],
      "settings": { "foreground": "#9096BC" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": { "foreground": "#7CA3F0" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.type.class"
      ],
      "settings": { "foreground": "#63C9A8" }
    },
    {
      "scope": ["entity.name.type.parameter", "meta.type.annotation", "support.type.primitive"],
      "settings": { "foreground": "#5FD0BE" }
    },
    {
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#C9CDE4" }
    },
    {
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#CBB4F5" }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.constant.property"
      ],
      "settings": { "foreground": "#9FD8E3" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#E3A567" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#A98BF5" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class.css"],
      "settings": { "foreground": "#4FC7D9" }
    },
    {
      "scope": ["entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#A98BF5" }
    },
    {
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": { "foreground": "#9FD8E3" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#E8C978" }
    },
    {
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#A98BF5" }
    },
    {
      "scope": ["source.json meta.structure.dictionary.value string"],
      "settings": { "foreground": "#4FC7D9" }
    },
    {
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#7CA3F0", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E3A567", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#4FC7D9" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8B90B4", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link.markdown"],
      "settings": { "foreground": "#3ABACD" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#63C9A8" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#F27A8D" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#E8C978" }
    },
    {
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#A98BF5" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#F27A8D" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#F27A8D", "fontStyle": "strikethrough" }
    },
    {
      "scope": ["entity.name.label", "keyword.other.definition"],
      "settings": { "foreground": "#A98BF5" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#CBB4F5",
    "property": "#9FD8E3",
    "variable.readonly": "#E3A567",
    "enumMember": "#E3A567",
    "class": "#63C9A8",
    "interface": "#5FD0BE",
    "type": "#63C9A8",
    "function": "#7CA3F0",
    "namespace": "#63C9A8",
    "*.defaultLibrary": "#A98BF5"
  }
}
