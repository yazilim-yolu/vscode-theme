  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment",
        "comment.block",
        "comment.line"
      ],
      "settings": { "foreground": "#5C6280", "fontStyle": "italic" }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": { "foreground": "#6E7599", "fontStyle": "italic" }
    },
    {
      "name": "JSDoc / doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "keyword.other.phpdoc",
        "storage.type.class.phpdoc"
      ],
      "settings": { "foreground": "#A98BF0", "fontStyle": "italic" }
    },
    {
      "name": "JSDoc types / references",
      "scope": [
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": { "foreground": "#8FD3DD", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "punctuation.definition.string",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": { "foreground": "#6FD0AE" }
    },
    {
      "name": "Template / interpolated strings",
      "scope": [
        "string.template",
        "string.interpolated",
        "punctuation.definition.string.template",
        "string.quoted.template"
      ],
      "settings": { "foreground": "#8AD9C0" }
    },
    {
      "name": "Template / embedded expression punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.embedded",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ],
      "settings": { "foreground": "#C8A6F5" }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape",
        "constant.character.string.escape",
        "constant.other.placeholder",
        "constant.character.entity.html"
      ],
      "settings": { "foreground": "#E6A579" }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": { "foreground": "#58C8D8" }
    },
    {
      "name": "Regexp anchors / quantifiers",
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": { "foreground": "#E0A46E" }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity",
        "support.constant",
        "constant.other.unicode-range"
      ],
      "settings": { "foreground": "#E0A46E" }
    },
    {
      "name": "Keywords & storage",
      "scope": [
        "keyword",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.logical.python",
        "keyword.other.using",
        "keyword.other.rust",
        "keyword.type.go",
        "keyword.function.go"
      ],
      "settings": { "foreground": "#A98BF0" }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.directive",
        "keyword.package",
        "keyword.import",
        "keyword.control.at-rule"
      ],
      "settings": { "foreground": "#C8A6F5" }
    },
    {
      "name": "this / super / self",
      "scope": [
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "variable.language.special.self",
        "constant.language.self",
        "keyword.other.this"
      ],
      "settings": { "foreground": "#E0879C", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.optional",
        "storage.type.function.arrow"
      ],
      "settings": { "foreground": "#8E99C2" }
    },
    {
      "name": "Separators & accessors",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": { "foreground": "#9096BC" }
    },
    {
      "name": "Braces, brackets, blocks",
      "scope": [
        "punctuation.definition.block",
        "punctuation.section",
        "punctuation.definition.array",
        "punctuation.section.brackets",
        "punctuation.section.parens",
        "punctuation.section.braces",
        "meta.brace"
      ],
      "settings": { "foreground": "#888EB8" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "meta.function-call",
        "variable.function",
        "entity.name.function.member",
        "entity.name.function.call",
        "entity.name.function.target.makefile"
      ],
      "settings": { "foreground": "#5AA6F0" }
    },
    {
      "name": "Built-in / support functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.magic.python",
        "support.function.builtin.shell",
        "support.function.builtin.go"
      ],
      "settings": { "foreground": "#74B6F3" }
    },
    {
      "name": "Types, classes, structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "storage.type.class",
        "meta.type.name"
      ],
      "settings": { "foreground": "#52C7BD" }
    },
    {
      "name": "Interfaces & type aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": { "foreground": "#7FD8C6" }
    },
    {
      "name": "Primitive & builtin types, generics",
      "scope": [
        "support.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.parameter",
        "meta.type.parameters",
        "meta.type.annotation",
        "storage.type.built-in",
        "storage.type.primitive"
      ],
      "settings": { "foreground": "#8ED0C0" }
    },
    {
      "name": "Namespaces & modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution",
        "entity.name.package",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": { "foreground": "#52C7BD" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable",
        "variable.other.assignment"
      ],
      "settings": { "foreground": "#BFC3DC" }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.parameter.function-call",
        "variable.parameter.function.language.python"
      ],
      "settings": { "foreground": "#D2ABF5" }
    },
    {
      "name": "Properties & object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.member",
        "variable.other.readwrite.instance.ruby",
        "variable.other.makefile"
      ],
      "settings": { "foreground": "#8FD3DD" }
    },
    {
      "name": "Constants & enum members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "variable.other.constant.property",
        "constant.other.symbol.ruby",
        "constant.other.key"
      ],
      "settings": { "foreground": "#E0A46E" }
    },
    {
      "name": "PHP / shell variable sigils",
      "scope": [
        "punctuation.definition.variable",
        "variable.other.php",
        "variable.other.normal.shell",
        "variable.other.env"
      ],
      "settings": { "foreground": "#8FD3DD" }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#E87D9C" }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": { "foreground": "#9096BC" }
    },
    {
      "name": "Components (JSX / Vue / Svelte)",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": { "foreground": "#52C7BD" }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": { "foreground": "#E0B884" }
    },
    {
      "name": "CSS class selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.mixin.css"
      ],
      "settings": { "foreground": "#5AA6F0" }
    },
    {
      "name": "CSS id selectors",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#A98BF0" }
    },
    {
      "name": "CSS tag / element selectors",
      "scope": ["entity.name.tag.css", "entity.name.tag.scss", "entity.name.tag.less"],
      "settings": { "foreground": "#E87D9C" }
    },
    {
      "name": "CSS pseudo classes / elements",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#74B6F3" }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": { "foreground": "#8FD3DD" }
    },
    {
      "name": "CSS property values / constants",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.property-value.scss",
        "meta.property-value.css"
      ],
      "settings": { "foreground": "#BFC3DC" }
    },
    {
      "name": "CSS units",
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#E0A46E" }
    },
    {
